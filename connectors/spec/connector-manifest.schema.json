{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-layer.tech/schemas/connectors/v1/connector-manifest.schema.json",
  "title": "AgentLayer Connector Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "publisher",
    "agentlayer",
    "trust",
    "transport",
    "permissions",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "agentlayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "runtime_range"],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "runtime_range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "trust": {
      "type": "string",
      "enum": [
        "community_read_only",
        "verified_read_only",
        "verified_write",
        "local_development"
      ]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {
          "const": "https"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "default": 10000
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallet_address", "transaction_intents", "network_hosts"],
      "properties": {
        "wallet_address": {
          "type": "boolean"
        },
        "balance_read": {
          "type": "boolean",
          "default": false
        },
        "transaction_intents": {
          "type": "boolean"
        },
        "x402_discovery": {
          "type": "boolean",
          "default": false
        },
        "network_hosts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        }
      }
    },
    "chains": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/chainPolicy"
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "jsonSchema": {
      "type": "object"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "read_only", "risk_level", "input_schema", "output_schema"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "read_only": {
          "type": "boolean"
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "input_schema": {
          "$ref": "#/$defs/jsonSchema"
        },
        "output_schema": {
          "$ref": "#/$defs/jsonSchema"
        }
      }
    },
    "chainPolicy": {
      "oneOf": [
        {
          "$ref": "#/$defs/evmPolicy"
        },
        {
          "$ref": "#/$defs/solanaPolicy"
        }
      ]
    },
    "evmPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain", "chain_ids", "contracts"],
      "properties": {
        "chain": {
          "const": "evm"
        },
        "chain_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chain_id", "address", "selectors"],
            "properties": {
              "chain_id": {
                "type": "integer",
                "minimum": 1
              },
              "address": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "selectors": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{8}$"
                }
              }
            }
          }
        }
      }
    },
    "solanaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain", "networks", "program_ids"],
      "properties": {
        "chain": {
          "const": "solana"
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["mainnet", "devnet", "testnet"]
          }
        },
        "program_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trust": {
            "enum": ["community_read_only", "verified_read_only"]
          }
        },
        "required": ["trust"]
      },
      "then": {
        "properties": {
          "permissions": {
            "properties": {
              "transaction_intents": {
                "const": false
              }
            }
          },
          "tools": {
            "items": {
              "properties": {
                "read_only": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trust": {
            "const": "verified_write"
          }
        },
        "required": ["trust"]
      },
      "then": {
        "required": ["artifact_digest", "chains"],
        "properties": {
          "permissions": {
            "properties": {
              "transaction_intents": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
