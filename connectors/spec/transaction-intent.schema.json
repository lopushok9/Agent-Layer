{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-layer.tech/schemas/connectors/v1/transaction-intent.schema.json",
  "title": "AgentLayer Connector Transaction Intent v1",
  "oneOf": [
    {
      "$ref": "#/$defs/evmIntent"
    },
    {
      "$ref": "#/$defs/solanaIntent"
    }
  ],
  "$defs": {
    "uintString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 80
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evmAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "solanaAddress": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "expectedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "asset", "direction", "amount"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["asset", "debt", "position", "protocol_fee", "network_fee"]
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "direction": {
          "type": "string",
          "enum": ["debit", "credit", "increase", "decrease"]
        },
        "amount": {
          "$ref": "#/$defs/uintString"
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "baseIntent": {
      "type": "object",
      "required": [
        "protocol_version",
        "connector_id",
        "connector_version",
        "artifact_digest",
        "tool",
        "quote_fingerprint",
        "expires_at",
        "expected_effects"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "connector_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
          "maxLength": 128
        },
        "connector_version": {
          "type": "string",
          "maxLength": 64
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "quote_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "expected_effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/expectedEffect"
          }
        }
      }
    },
    "evmCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "data", "value_wei"],
      "properties": {
        "to": {
          "$ref": "#/$defs/evmAddress"
        },
        "data": {
          "type": "string",
          "pattern": "^0x(?:[0-9a-fA-F]{2})*$",
          "maxLength": 262146
        },
        "value_wei": {
          "$ref": "#/$defs/uintString"
        },
        "purpose": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "evmApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "spender", "amount_raw"],
      "properties": {
        "token": {
          "$ref": "#/$defs/evmAddress"
        },
        "spender": {
          "$ref": "#/$defs/evmAddress"
        },
        "amount_raw": {
          "$ref": "#/$defs/uintString"
        }
      }
    },
    "evmIntent": {
      "allOf": [
        {
          "$ref": "#/$defs/baseIntent"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol_version",
            "connector_id",
            "connector_version",
            "artifact_digest",
            "tool",
            "quote_fingerprint",
            "expires_at",
            "expected_effects",
            "kind",
            "chain_id",
            "from",
            "calls",
            "approvals"
          ],
          "properties": {
            "protocol_version": true,
            "connector_id": true,
            "connector_version": true,
            "artifact_digest": true,
            "tool": true,
            "quote_fingerprint": true,
            "expires_at": true,
            "expected_effects": true,
            "kind": {
              "const": "evm_transaction_intent"
            },
            "chain_id": {
              "type": "integer",
              "minimum": 1
            },
            "from": {
              "$ref": "#/$defs/evmAddress"
            },
            "calls": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/evmCall"
              }
            },
            "approvals": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/evmApproval"
              }
            }
          }
        }
      ]
    },
    "solanaIntent": {
      "allOf": [
        {
          "$ref": "#/$defs/baseIntent"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol_version",
            "connector_id",
            "connector_version",
            "artifact_digest",
            "tool",
            "quote_fingerprint",
            "expires_at",
            "expected_effects",
            "kind",
            "network",
            "fee_payer",
            "transaction_base64",
            "program_ids"
          ],
          "properties": {
            "protocol_version": true,
            "connector_id": true,
            "connector_version": true,
            "artifact_digest": true,
            "tool": true,
            "quote_fingerprint": true,
            "expires_at": true,
            "expected_effects": true,
            "kind": {
              "const": "solana_transaction_intent"
            },
            "network": {
              "type": "string",
              "enum": ["mainnet", "devnet", "testnet"]
            },
            "fee_payer": {
              "$ref": "#/$defs/solanaAddress"
            },
            "transaction_base64": {
              "type": "string",
              "minLength": 1,
              "maxLength": 524288,
              "contentEncoding": "base64"
            },
            "program_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/solanaAddress"
              }
            },
            "required_accounts": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/solanaAddress"
              }
            }
          }
        }
      ]
    }
  }
}
