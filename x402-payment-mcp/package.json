{
  "name": "@agentlayer/x402-payment-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "keys": "tsx scripts/generate-signing-key.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.55.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/svm": "^2.25.0",
    "express": "^5.1.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "undici": "8.10.2",
    "zod": "4.6.2"
  },
  "overrides": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
