PUBLIC_BASE_URL=https://mcp.example.com
# Local loopback development only; never enable in production.
MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=false
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/x402_payment_mcp

# Generate with: npm run keys
OAUTH_SIGNING_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","kid":"..."}
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300
# Personal access tokens for bearer-only hosts such as Meta Muse.
PERSONAL_TOKEN_TTL_DAYS=90
PERSONAL_TOKEN_MAX_ACTIVE=10
PREVIEW_TTL_SECONDS=120
# Arc mainnet USDC transfers (6-decimal atomic units).
# Required: set this as a Railway service secret. Create an Arc Mainnet app in
# Alchemy and substitute its API key; do not commit a real key to this file.
ARC_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_API_KEY
ARC_MAX_TRANSFER_USDC_ATOMIC=50000000
ARC_MAX_DAILY_TRANSFER_USDC_ATOMIC=200000000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Atomic USDC units (6 decimals): 1000000 = 1 USDC.
SPEND_LIMITS_ENABLED=false
MAX_PAYMENT_USDC_ATOMIC=1000000
MAX_DAILY_USDC_ATOMIC=5000000
PAYMENT_TIMEOUT_MS=15000
